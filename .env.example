# Copia este archivo como .env.local y llena los valores de tu proyecto de Supabase
# (Project Settings > API). En Vercel se ponen en Settings > Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
# Opcional: domicilio que aparece en los recibos
NEXT_PUBLIC_DOMICILIO_NEGOCIO=Tamuín, S.L.P.
# Opcionales: datos del patrón que salen en recibos y hojas semanales
NEXT_PUBLIC_PATRON_NOMBRE=Restaurante Los Curros
NEXT_PUBLIC_PATRON_RFC=
NEXT_PUBLIC_REGISTRO_PATRONAL=
# Opcional (solo servidor): primer día que muestra la plataforma, AAAA-MM-DD.
# Si no se pone, es el día de implementación (2026-10-24). Las pruebas lo mueven.
FECHA_INICIO=
